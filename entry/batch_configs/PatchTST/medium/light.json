{
  "_doc": "PatchTST self-supervised (masked) at the shared encoder capacity. Cohort light, standard prediction lengths [96, 192, 336, 720], 5 seeds.",
  "name": "PatchTST_medium_light",
  "model_id": "PatchTST",
  "datasets": [
    "ETTh1",
    "ETTh2",
    "ETTm1",
    "ETTm2",
    "exchange_rate",
    "weather"
  ],
  "stages": [
    "pretrain",
    "train",
    "test"
  ],
  "cuda_visible_devices": "0",
  "min_free_mb": 2000,
  "concurrent": 4,
  "delay": 10,
  "env": {
    "OMP_NUM_THREADS": "1",
    "MKL_NUM_THREADS": "1",
    "OPENBLAS_NUM_THREADS": "1",
    "NUMEXPR_NUM_THREADS": "1"
  },
  "run_name": {
    "base": "arch_scan",
    "include": [
      "n_layers",
      "seed"
    ],
    "aliases": {
      "n_layers": "Enc",
      "seed": "S"
    }
  },
  "grid": {
    "pretrain.n_layers": [
      2
    ],
    "seed": [
      2021,
      2022,
      2023,
      2024,
      2025
    ]
  },
  "stage_defaults": {
    "pretrain": {
      "features": "M",
      "input_len": 96,
      "patch_len": 8,
      "n_layers": 2,
      "n_heads": 4,
      "d_model": 32,
      "d_ff": 64,
      "dropout": 0.2,
      "head_dropout": 0.1,
      "lr": 0.001,
      "revin": 1,
      "scaler": "standard",
      "use_time_features": 0,
      "mask_ratio": 0.4,
      "batch_size": 16,
      "train_epochs": 50,
      "num_workers": 4,
      "checkpoint_every": 0
    },
    "train": {
      "pred_lens": [
        96,
        192,
        336,
        720
      ],
      "mode": "finetune",
      "dropout": 0.2,
      "head_dropout": 0.1,
      "lr": 0.0001,
      "train_epochs": 10,
      "freeze_epochs": 0,
      "batch_size": 16,
      "num_workers": 2
    },
    "test": {
      "pred_lens": [
        96,
        192,
        336,
        720
      ],
      "batch_size": 16,
      "num_workers": 2
    }
  },
  "variants": [
    {
      "name": "pretrained",
      "load_pretrain_weights": 1
    }
  ]
}
